# Copy to .env for local development.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/real_stay
# local | gcs (gcs is also inferred when PHOTO_BUCKET is set)
STORAGE=local
LOCAL_STORAGE_DIR=./data
PUBLIC_API_URL=http://localhost:4000
# PHOTO_BUCKET=my-bucket            # when STORAGE=gcs
APP_ORIGIN=http://localhost:5173
# dev (name → account) | firebase (documented swap, not implemented)
AUTH_PROVIDER=dev
JWT_SECRET=change-me
NEAR_RADIUS_M=500
# seeds sample content into an empty database on boot; set false to disable
SEED_ON_BOOT=true
# path prefix stripped at the edge of the API (defaults to "api" in production, none otherwise)
# API_PREFIX=api
